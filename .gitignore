# Local credentials — never commit. .env.example is the only one tracked.
.env
.env.*
!.env.example

# Rendered Helm values (generated by scripts/render.sh, may contain endpoints)
.render/

# Local migration sessions and Python test/cache artifacts
.migration-work/
*.local.json
checkpoint.local.json
*.local.jsonl
__pycache__/
.pytest_cache/

# Backups left by scripts/render-codex-mcp.sh --install
*.toml.bak

# Editor / OS noise
.DS_Store
*.swp

# Migration session outputs from real runs (raw and sanitized) - never commit
.observability-migration/
.observability-migration-work/

# Build output: plugin packages are attached to GitHub Releases, not committed
dist/

# macOS AppleDouble files
._*
