# =============================================================================
# otel-demo-multibackend  —  copy to .env and fill in what you need.
#
#   cp .env.example .env && ${EDITOR:-vi} .env && ./run.sh
#
# Every destination is independent. Leave a destination's credentials blank and
# it is simply not wired into the collector. You can run with zero destinations
# (local Jaeger/Grafana only) to smoke-test the cluster first.
# =============================================================================

# -----------------------------------------------------------------------------
# Cluster
# -----------------------------------------------------------------------------
# minikube | kind | current   ("current" uses your existing kubectl context)
CLUSTER_TYPE="minikube"
CLUSTER_NAME="otel-demo"
NAMESPACE="otel-demo"

# Sizing for minikube/kind. The demo app alone wants ~4 vCPU / 6 GiB.
# On an EC2 box give it more; on a 16 GiB laptop these defaults are the sweet spot.
CLUSTER_CPUS="4"
CLUSTER_MEMORY_MB="10240"
# Container engine backing the cluster: podman (default) or docker.
CONTAINER_ENGINE="podman"

# minikube driver. Leave empty to use CONTAINER_ENGINE.
# Set it explicitly to run minikube in its own VM with no container engine:
#   vfkit, qemu2  (macOS)      kvm2  (Linux)
# Note: minikube's podman driver is marked experimental upstream. If it gives
# you trouble, CLUSTER_TYPE="kind" is the better-travelled podman path.
MINIKUBE_DRIVER=""

# macOS and Windows only: podman runs inside a VM it calls a "machine".
# run.sh creates it if absent, sized from CLUSTER_CPUS/CLUSTER_MEMORY_MB plus
# 2 GiB of headroom, and makes it rootful (required by minikube's podman driver).
# Ignored on Linux, where podman is native.
PODMAN_MACHINE_NAME="podman-machine-default"

# The kubelet's /stats/summary endpoint is the source of all pod and container
# metrics. minikube and kind sign it with a self-signed certificate that has no
# IP SANs, so verification fails and those metrics vanish silently. Left empty,
# this is true for minikube/kind and false for an existing cluster.
KUBELET_INSECURE_SKIP_VERIFY=""

# What preflight does when kubectl / helm / minikube / kind are missing.
#   ask    (default) list them and prompt before installing
#   always install without prompting  — same as ./run.sh --yes
#   never  fail instead                — same as ./run.sh --no-install
# Homebrew is used when present, otherwise the official release binaries are
# downloaded. Docker and python3 are never installed automatically.
AUTO_INSTALL_TOOLS="ask"

# --- Who is running this -----------------------------------------------------
# Several engineers usually point this demo at the same Datadog org / Splunk
# realm. Without a per-run identity every copy reports the same services, the
# same environment and the same cluster, and the backends merge them into one
# unreadable pile.
#
# Leave DEMO_INSTANCE empty and it is derived as <user>-<hostname>, e.g.
# "odiak-mn66cg69hp". Set it by hand for something stabler, like "perf-test"
# or a ticket number. It is stamped on every span, metric and log as
# demo.instance, and folded into the two attributes the backends partition on:
#
#   deployment.environment  ->  Splunk APM environment selector, Datadog env tag
#   k8s.cluster.name        ->  Splunk/Datadog infrastructure and correlation
DEMO_INSTANCE=""

# Leave empty to derive as otel-demo-<DEMO_INSTANCE>. Set explicitly to pin an
# environment name — but make sure it is unique per person if you share an org.
DEPLOYMENT_ENVIRONMENT=""

# Cluster name as the BACKENDS see it. Empty derives <CLUSTER_NAME>-<DEMO_INSTANCE>.
# CLUSTER_NAME itself stays the local minikube/kind profile and only has to be
# unique on your own machine.
TELEMETRY_CLUSTER_NAME=""

# Keep the demo's bundled Jaeger / Prometheus / Grafana / OpenSearch?
# false  -> saves ~3 GiB, telemetry goes only to the SaaS destinations.
# true   -> useful for verifying data locally before blaming a vendor.
KEEP_LOCAL_BACKENDS="false"

# -----------------------------------------------------------------------------
# Load + error injection
# -----------------------------------------------------------------------------
# Concurrent k6 virtual users driving the storefront (upstream default: 5).
LOAD_GENERATOR_VUS="5"

# Continuously exercise the demo's AI agent so GenAI spans keep flowing.
# Uses the demo's recorded LLM cassettes (USE_VCR=True) — no LLM key, no cost.
AI_LOAD_ENABLED="true"
AI_LOAD_INTERVAL_SECONDS="20"

# Baseline random error injection via flagd (see config/flagd/chaos.flagd.json).
# "off"      -> no injected failures, healthy baseline
# "steady"   -> constant low-rate random failures (recommended for a demo)
# "chaos"    -> higher rates + latency/leak flags, for incident walkthroughs
ERROR_INJECTION_PROFILE="steady"

# -----------------------------------------------------------------------------
# Destination 1 — Datadog
# -----------------------------------------------------------------------------
# Leave DD_API_KEY blank to skip Datadog entirely.
DD_API_KEY=""
# datadoghq.com | datadoghq.eu | us3.datadoghq.com | us5.datadoghq.com | ap1.datadoghq.com | ddog-gov.com
DD_SITE="datadoghq.com"

# -----------------------------------------------------------------------------
# Destination 2 — Splunk Observability Cloud (APM + Infrastructure Monitoring)
# -----------------------------------------------------------------------------
# Leave SPLUNK_O11Y_ACCESS_TOKEN blank to skip.
SPLUNK_O11Y_REALM="us1"
SPLUNK_O11Y_ACCESS_TOKEN=""

# Optional organization pin for the Phase 2 migration executor. The executor uses the
# same complete Splunk token/realm profile selected during assessment, reads the actual
# organization through the API, and binds each authorized wave to its hash.
SPLUNK_O11Y_ORG_ID=""

# -----------------------------------------------------------------------------
# Destination 3 — Splunk Enterprise / Splunk Cloud Platform (HEC)
# -----------------------------------------------------------------------------
# Full HEC event endpoint, e.g. https://splunk.example.com:8088/services/collector/event
# Leave blank to skip.
SPLUNK_HEC_ENDPOINT=""
SPLUNK_HEC_TOKEN=""
SPLUNK_HEC_INDEX_LOGS="main"
SPLUNK_HEC_INDEX_METRICS="otel_metrics"
SPLUNK_HEC_INDEX_TRACES="otel_traces"
# Set to "true" for a Splunk instance with a self-signed certificate.
SPLUNK_HEC_INSECURE_SKIP_VERIFY="false"

# -----------------------------------------------------------------------------
# Destination 4 — Splunk Agent Observability (AI agent / GenAI observability)
# -----------------------------------------------------------------------------
# Separate product from Splunk Observability Cloud, with its own OTLP endpoint.
# GenAI spans (gen_ai.* semconv) are branched here in addition to APM.
# See docs/SPLUNK-AGENT-OBSERVABILITY.md
#
# Cloud deployments: leave SPLUNK_AO_API_URL at the default.
# Self-hosted:       set it to your console URL.
SPLUNK_AO_API_KEY=""
SPLUNK_AO_API_URL="https://api.splunk-ao.splunk.com"
SPLUNK_AO_PROJECT="otel-demo"
SPLUNK_AO_AGENT_STREAM="astronomy-shop"

# -----------------------------------------------------------------------------
# Debugging
# -----------------------------------------------------------------------------
# Add the `debug` exporter to every pipeline (verbose collector logs).
COLLECTOR_DEBUG_EXPORTER="false"

# =============================================================================
# AGENT / SKILLS ENVIRONMENT  (for Claude Code and the migration skills)
#
# Everything below this line is read by .mcp.json and scripts/verify-mcp.sh.
# None of it affects the deployed demo or the collector — it is the read path
# an agent uses to inventory Datadog and write into Splunk.
#
# IMPORTANT: .mcp.json expands these from the SHELL ENVIRONMENT, not from this
# file. `run.sh` sourcing .env is not enough. Export them before launching:
#
#     set -a; source .env; set +a; claude
#
# Check everything with:  scripts/verify-mcp.sh
# Full setup guide:       docs/MCP-SETUP.md
# =============================================================================

# -----------------------------------------------------------------------------
# Agent connection 1 — Datadog MCP Server (migration SOURCE)
# -----------------------------------------------------------------------------
# Remote MCP server, one endpoint per Datadog site. Authentication is OAuth by
# default: leave the keys below blank, start Claude Code, and it opens a browser
# on first use. Nothing secret needs to live on disk.
#
# Host must match DD_SITE above:
#   datadoghq.com -> mcp.datadoghq.com      datadoghq.eu  -> mcp.datadoghq.eu
#   us3/us5/ap1   -> mcp.<site>             (mirror the site hostname)
DD_MCP_HOST="mcp.datadoghq.com"

# Which tool groups the server exposes. Fewer toolsets = less context burned.
# "core,dashboards,alerting" covers the migration inventory: dashboards,
# monitors, SLOs, metrics, logs, spans. Use "all" to load everything.
# Other useful ones: ddsql, kubernetes, cost, synthetics, rum, profiling.
DD_MCP_TOOLSETS="core,dashboards,alerting"

# Only needed for headless/CI runs where the OAuth browser flow is not
# available, and by scripts/verify-mcp.sh to validate credentials directly
# against the Datadog API.
#
# DD_API_KEY is reused from the Datadog destination section above.
# The APPLICATION key is separate and is what authorises reads of dashboards,
# monitors and SLOs: Organization Settings -> Application Keys.
# Requires the mcp_read permission plus read access to the resources you query.
DD_APP_KEY=""

# -----------------------------------------------------------------------------
# Agent connection 2 — Splunk Observability Cloud, via the SCS MCP Gateway
# -----------------------------------------------------------------------------
# Gives the agent read access to Splunk Observability Cloud: APM services,
# metrics, SignalFlow, detectors. Leave the token blank and the MCP server
# simply fails to connect; nothing else breaks.
#
# Token = an Observability Cloud *API access token* (Settings -> Access Tokens),
# not an ingest token. The token alone selects the org, so one per org.
#
# innovationlab org (HP5zPsfCgCs) — where THIS repo's OTel demo reports.
SPLUNK_O11Y_INNOVATIONLAB_TOKEN=""
SPLUNK_O11Y_INNOVATIONLAB_REALM="eu1"

# The gateway is region-specific and the region must match the o11y realm:
#   eu0 -> dub10   eu1 -> fra10   eu2 -> lon10
#   us0 -> iad10   us1/us2/us3 -> pdx10
#   jp0 -> tyo10   au0 -> syd10   sg0 -> sin10
# Leave blank to use the fra10 default baked into .mcp.json.
SPLUNK_MCP_GATEWAY_URL=""

# -----------------------------------------------------------------------------
# Agent connection 3 — Splunk Enterprise / Cloud Platform MCP (migration TARGET)
# -----------------------------------------------------------------------------
# SPL search, saved searches and knowledge objects. Requires the Splunk MCP
# Server app (Splunkbase 7931) installed on your search head, and a role with
# the mcp_tool_execute capability. Both values are shown in the app itself.
#
# Endpoint copied from the Splunk MCP Server app, e.g.
#   https://<your-stack>.splunkcloud.com:8089/services/mcp
# Leave blank to disable this MCP server.
SPLUNK_MCP_PLATFORM_URL=""

# An ENCRYPTED token generated inside the Splunk MCP Server app. A normal
# Splunk API token will not work, and this token cannot be used for direct
# REST calls — it is MCP-only.
SPLUNK_MCP_PLATFORM_TOKEN=""

# Splunk platform REST endpoint (management port, usually :8089). Used only by
# scripts/verify-mcp.sh to prove the search head is reachable, since the
# encrypted MCP token cannot be tested against the REST API.
# Pair it with a normal Splunk API token (Settings -> Tokens).
SPLUNK_PLATFORM_API_URL=""
SPLUNK_PLATFORM_API_TOKEN=""

# The MCP Server app is delivered over stdio by the `mcp-remote` npm bridge.
# Pin deliberately; update this value only after validating the bridge release.
MCP_REMOTE_VERSION="0.1.49"
