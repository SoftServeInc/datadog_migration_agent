{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cisco-innovation.local/schemas/translation-manifest.schema.json",
  "title": "Sealed Splunk translation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "source_session_id", "plan_hash", "plan_review_approval_hash", "source_binding", "target", "wave_id", "max_creates", "sealed_at", "entries", "safety", "manifest_hash"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "manifest_id": {"type": "string", "pattern": "^manifest-[a-f0-9]{16}$"},
    "source_session_id": {"type": "string", "minLength": 8, "maxLength": 64},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_review_approval_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_method", "inventory_hash", "inventory_ir_hash"],
      "properties": {
        "binding_method": {"const": "phase1_local_inventory_ir_rebuild_v1"},
        "inventory_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "inventory_ir_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "target": {"const": "splunk_observability_cloud"},
    "wave_id": {"type": "string", "pattern": "^wave-[A-Za-z0-9][A-Za-z0-9_-]{2,31}$"},
    "max_creates": {"type": "integer", "minimum": 1, "maximum": 10},
    "sealed_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_ref", "target_kind", "operation", "execution_key", "marker_tag", "payload", "payload_hash", "semantic_review"],
        "properties": {
          "object_ref": {"type": "string", "pattern": "^obj_[a-f0-9]{16}$"},
          "target_kind": {"const": "detector"},
          "operation": {"const": "CREATE_DETECTOR"},
          "execution_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "marker_tag": {"type": "string", "pattern": "^codex-migration-[a-f0-9]{16}$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "programText", "rules", "tags", "customProperties"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 255},
              "programText": {"type": "string", "minLength": 1, "maxLength": 100000},
              "description": {"type": "string", "minLength": 1, "maxLength": 1024},
              "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
              "tags": {
                "type": "array", "maxItems": 50, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 256},
                "contains": {"pattern": "^codex-migration-[a-f0-9]{16}$"}
              },
              "customProperties": {
                "type": "object",
                "required": ["migrationExecutionKey", "migrationPlanHash"],
                "minProperties": 2,
                "maxProperties": 20,
                "properties": {
                  "migrationExecutionKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "migrationPlanHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                },
                "patternProperties": {"^[A-Za-z][A-Za-z0-9_-]{0,127}$": {"type": ["string", "number", "boolean"], "maxLength": 256}},
                "additionalProperties": false
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["detectLabel", "severity", "disabled", "notifications"],
                  "properties": {
                    "detectLabel": {"type": "string", "minLength": 1, "maxLength": 128},
                    "severity": {"enum": ["Critical", "Major", "Minor", "Warning", "Info"]},
                    "disabled": {"const": true},
                    "notifications": {"type": "array", "maxItems": 0},
                    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
                    "runbookUrl": {"type": "string", "minLength": 1, "maxLength": 1024},
                    "tip": {"type": "string", "minLength": 1, "maxLength": 1024}
                  }
                }
              }
            }
          },
          "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "semantic_review": {
            "oneOf": [
              {"const": {"source_intent_reviewed": true, "signalflow_reviewed": true, "differences_accepted": true}},
              {"const": {"review_method": "automatic_allowlisted_v1", "source_intent_reviewed": false, "signalflow_reviewed": false, "differences_accepted": false, "allowlisted_shape_validated": true, "disabled_effects_validated": true}}
            ]
          }
        }
      }
    },
    "safety": {
      "const": {"create_only": true, "updates_authorized": false, "deletes_authorized": false, "notifications_enabled": false}
    },
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": "1.1"}}},
    "then": {
      "properties": {
        "entries": {
          "items": {
            "properties": {
              "payload": {
                "properties": {
                  "tags": {"contains": {"const": "AI-Created"}}
                }
              }
            }
          }
        }
      }
    }
  }]
}
